<Window x:Class="PdfSorter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PdfSorter.App.ViewModels"
        xmlns:conv="clr-namespace:PdfSorter.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="PDF Sorter — сортировка и переименование PDF"
        Icon="Assets/app.ico"
        Width="1360" Height="860" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />

        <Style x:Key="GlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>

        <!-- Статус строки предпросмотра: цвет точки и текста зависит от состояния -->
        <DataTemplate x:Key="StatusCellTemplate" DataType="{x:Type vm:PlanRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{StaticResource AccentBrush}" />
                <TextBlock x:Name="Text" Grid.Column="1" Text="{Binding ShortStatus}" ToolTip="{Binding Status}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Skipped">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource MutedBrush}" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource ErrorBrush}" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Reverted">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="9" Background="{StaticResource AccentBrush}">
                    <Viewbox Margin="8">
                        <Canvas Width="24" Height="24">
                            <Path Data="M5,2 H14 L19,7 V22 H5 Z" Fill="White" />
                            <Path Data="M14,2 V7 H19 Z" Fill="#BFD3FB" />
                            <Rectangle Canvas.Left="8" Canvas.Top="11" Width="8" Height="1.8" Fill="{StaticResource AccentBrush}" />
                            <Rectangle Canvas.Left="8" Canvas.Top="14.5" Width="8" Height="1.8" Fill="{StaticResource AccentBrush}" />
                            <Rectangle Canvas.Left="8" Canvas.Top="18" Width="5" Height="1.8" Fill="{StaticResource AccentBrush}" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PDF Sorter" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Пакетная сортировка и переименование PDF-файлов по правилам"
                               Style="{StaticResource HintTextStyle}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Журналы операций: " Style="{StaticResource HintTextStyle}" />
                    <Button Style="{StaticResource LinkButtonStyle}" FontSize="12"
                            Content="{Binding JournalDirectory}"
                            Command="{Binding OpenJournalFolderCommand}"
                            ToolTip="Открыть папку журналов в Проводнике" />
                </StackPanel>
            </DockPanel>

            <!-- Папки и общие параметры -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="0.55*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Исходная папка" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Command="{Binding BrowseSourceCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource GlyphStyle}" />
                            <TextBlock Text="Обзор…" />
                        </StackPanel>
                    </Button>
                    <CheckBox Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Content="Включая подпапки"
                              IsChecked="{Binding IncludeSubfolders}" />

                    <TextBlock Grid.Row="2" Text="Целевая папка" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" Command="{Binding BrowseTargetCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource GlyphStyle}" />
                            <TextBlock Text="Обзор…" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Режим" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="Перемещать" IsChecked="{Binding IsMoveMode}" />
                        <RadioButton Content="Копировать" IsChecked="{Binding IsCopyMode}" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Text="Шаблон имени" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource MonoTextBoxStyle}"
                             Text="{Binding FileNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Общий шаблон имени для правил без собственного шаблона" />
                    <TextBlock Grid.Row="4" Grid.Column="4" Text="Папка для прочих" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Row="4" Grid.Column="5" Style="{StaticResource MonoTextBoxStyle}"
                             Text="{Binding FallbackFolder, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Сюда попадают файлы, к которым не подошло ни одно правило. Пусто — такие файлы пропускаются." />

                    <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,6,0,0" Style="{StaticResource HintTextStyle}">
                        <Run Text="Подстановки:" />
                        <Run Text="{Binding PlaceholdersHelp, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" />
                        <Run Text="· недопустимые символы заменяются на «_», при совпадении имён добавляется (2), (3)…" />
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Правила и предпросмотр -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="470" MinWidth="440" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" IsEnabled="{Binding IsIdle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="110" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8E5;" Command="{Binding LoadRulesCommand}"
                                            ToolTip="Загрузить набор правил из JSON" />
                                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74E;" Command="{Binding SaveRulesCommand}"
                                            Margin="4,0,0,0" ToolTip="Сохранить набор правил в JSON" />
                                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Command="{Binding ResetRulesCommand}"
                                            Margin="4,0,0,0" ToolTip="Вернуть правила по умолчанию" />
                                </StackPanel>
                                <TextBlock Text="Правила сортировки" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="Проверяются сверху вниз, срабатывает первое подошедшее." Margin="0,2,0,0"
                                       Style="{StaticResource HintTextStyle}" />
                        </StackPanel>

                        <DockPanel Grid.Row="1" Margin="0,10,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74A;" Command="{Binding MoveRuleUpCommand}" ToolTip="Выше" />
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74B;" Command="{Binding MoveRuleDownCommand}" Margin="4,0,0,0" ToolTip="Ниже" />
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" Command="{Binding RemoveRuleCommand}" Margin="4,0,0,0" ToolTip="Удалить правило" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding AddFileNameRuleCommand}" Margin="0,0,6,0"
                                        ToolTip="Маска (* и ?) или регулярное выражение по имени файла">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource GlyphStyle}" />
                                        <TextBlock Text="По имени" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddDateRuleCommand}" Margin="0,0,6,0"
                                        ToolTip="Дата из имени файла или дата изменения, раскладка по {yyyy}/{MM}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource GlyphStyle}" />
                                        <TextBlock Text="По дате" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddPdfTextRuleCommand}"
                                        ToolTip="Ключевое слово или регулярное выражение по тексту первой страницы">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource GlyphStyle}" />
                                        <TextBlock Text="По тексту" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Rules}"
                                 SelectedItem="{Binding SelectedRule}"
                                 ItemContainerStyle="{StaticResource RuleListItemStyle}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RuleViewModel}">
                                    <Grid x:Name="Item">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" ToolTip="Правило включено" />
                                        <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11" Margin="6,0,10,0"
                                                Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding KindTitle, Mode=OneWay}" /><Run Text=":" />
                                                <Run Text="{Binding Description, Mode=OneWay}" />
                                                <Run Text="→" />
                                                <Run Text="{Binding TargetFolder, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Margin="6,0,0,0"
                                                   Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center"
                                                   ToolTip="{Binding ValidationError}"
                                                   Visibility="{Binding ValidationError, Converter={StaticResource NotEmptyToVisibility}}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter TargetName="Item" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Редактор выбранного правила -->
                        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="0,10,0,0" Margin="0,6,0,0"
                                Visibility="{Binding SelectedRule, Converter={StaticResource NotEmptyToVisibility}}">
                            <Grid DataContext="{Binding SelectedRule}" Grid.IsSharedSizeScope="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Правило №" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="7,1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding KindTitle}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Название" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                <ContentControl Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Content="{Binding}" Focusable="False" />

                                <TextBlock Grid.Row="3" Text="Папка" Style="{StaticResource FieldLabelStyle}" Margin="0,8,10,0" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MonoTextBoxStyle}"
                                         Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Шаблон папки относительно целевой, например Счета/{yyyy}/{MM}" />

                                <TextBlock Grid.Row="4" Text="Имя файла" Style="{StaticResource FieldLabelStyle}" Margin="0,8,10,0" />
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MonoTextBoxStyle}"
                                         Text="{Binding FileNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Шаблон имени для этого правила. Пусто — общий шаблон имени." />

                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource ErrorBrush}" FontSize="12"
                                           Text="{Binding ValidationError}"
                                           Visibility="{Binding ValidationError, Converter={StaticResource NotEmptyToVisibility}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="200" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="150" MinHeight="90" />
                    </Grid.RowDefinitions>

                    <!-- Предпросмотр -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="#FFF4E5" CornerRadius="4" Padding="8,2"
                                        Visibility="{Binding IsPlanOutdated, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Настройки изменены — обновите предпросмотр" FontSize="12"
                                               Foreground="{StaticResource WarningBrush}" />
                                </Border>
                                <TextBlock Text="Предпросмотр" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource HintTextStyle}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                            </DockPanel>

                            <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding PlanRows}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="38"
                                                        Foreground="{StaticResource SubtleTextBrush}" />
                                    <DataGridTemplateColumn Header="Исходный файл" Width="0.95*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Source}" Style="{StaticResource CellTextStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Новый путь" Width="1.35*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Destination}" Style="{StaticResource CellTextStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Правило" Width="0.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Rule}" Style="{StaticResource CellTextStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Статус" Width="1.05*" CellTemplate="{StaticResource StatusCellTemplate}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasPlan, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                                <TextBlock Text="Нажмите «Предпросмотр», чтобы увидеть, куда попадут файлы."
                                           HorizontalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                                <TextBlock Text="На этом шаге ничего не перемещается и не переименовывается."
                                           HorizontalAlignment="Center" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="1" Height="12" HorizontalAlignment="Stretch" Background="Transparent"
                                  ResizeDirection="Rows" ToolTip="Потяните, чтобы изменить размер" />

                    <!-- Журнал -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="Журнал операций" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="каждый пакет сохраняется в отдельный JSON-файл" Style="{StaticResource HintTextStyle}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                            </DockPanel>
                            <ListBox x:Name="LogList" Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Log}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="2,1" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LogEntryViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                            <TextBlock x:Name="Glyph" Grid.Column="1" Text="{Binding Glyph}" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                            <TextBlock x:Name="Message" Grid.Column="2" Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                <Setter TargetName="Message" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                <Setter TargetName="Message" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Действия и прогресс -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding PreviewCommand}" Margin="0,0,8,0"
                                ToolTip="Построить план: исходный файл → новый путь. Файлы не меняются.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B3;" Style="{StaticResource GlyphStyle}" />
                                <TextBlock Text="Предпросмотр" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DryRunCommand}" Margin="0,0,8,0"
                                ToolTip="Построить план и записать журнал, не трогая файлы">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource GlyphStyle}" />
                                <TextBlock Text="Пробный прогон" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExecuteCommand}" Margin="0,0,8,0"
                                MinWidth="130" ToolTip="Переместить или скопировать файлы по плану">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource GlyphStyle}" />
                                <TextBlock Text="Выполнить" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelCommand}"
                                ToolTip="Остановить текущую операцию. Уже обработанные файлы останутся в журнале.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" Style="{StaticResource GlyphStyle}" />
                                <TextBlock Text="Стоп" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="18,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource HintTextStyle}"
                                       Margin="10,0,0,0" TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                        </DockPanel>
                        <ProgressBar Grid.Row="1" Margin="0,6,0,0" Maximum="100" Value="{Binding Progress}" />
                    </Grid>

                    <Button Grid.Column="2" Command="{Binding UndoCommand}"
                            ToolTip="{Binding UndoDescription}" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource GlyphStyle}" />
                            <TextBlock Text="Отменить последнюю операцию" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
